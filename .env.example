# Copia estas variables en Plesk → Node.js → Variables de entorno personalizadas.
# NUNCA subas un archivo .env con valores reales al repositorio.

# "staging" mientras pruebas; "production" cuando se publique (quita el noindex y la contraseña).
SITE_ENV=staging
SITE_URL=https://expe.guiandalucia.es

# Usuario y contraseña de acceso a la web de pruebas (elige los tuyos).
STAGING_USER=
STAGING_PASS=

# Datos legales del titular. Se rellenan solo en el servidor.
LEGAL_NAME=Antonio GM
LEGAL_LOCALITY=Granada
LEGAL_NIF=
LEGAL_ADDRESS=
LEGAL_EMAIL=

# Se añaden en fases posteriores:
